# Postgres connection string.
# Supabase cloud: Project Settings > Database > Connection string > "Transaction pooler" (port 6543)
# Local Supabase CLI: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# Shared invite code friends must enter at /signup. Empty or unset = sign-up closed
# (the superadmin can still add amigos from /admin/users).
INVITE_CODE=
